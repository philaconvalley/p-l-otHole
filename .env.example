# Database (PostgreSQL + PostGIS)
# Local docker-compose default:
DATABASE_URL=postgresql://plothole:plothole@localhost:5432/plothole

# Redis
# Local docker-compose default:
REDIS_URL=redis://localhost:6379

# Mapbox — free-tier token sufficient for development
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_token_here

# S3-compatible object storage (AWS S3, Cloudflare R2, or MinIO)
S3_BUCKET=plothole-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
# Optional: override endpoint for non-AWS providers (R2, MinIO)
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# NextAuth.js
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (optional — at least one or magic link required)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (for magic link auth — skip for local dev with GitHub/Google OAuth)
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=noreply@plothole.org
